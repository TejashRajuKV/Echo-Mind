# =====================================================================
# Echo Mind - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# =====================================================================

# Backend API Authentication Key
# Used to authenticate protected API requests (e.g., /stats or external API access)
ECHO_MIND_API_KEY=your_secure_api_key_here

# Flask Server Port
PORT=8080

# Security & Production Settings
FLASK_DEBUG=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_REQUESTS_PER_HOUR=100
MAX_CLAIM_LENGTH=2000

# Google Cloud Configuration
PROJECT_ID=your_gcp_project_id
LOCATION=asia-south1

# Google Fact Check Tools API Key
# Optional: Get from Google Cloud Console (Enable Fact Check Tools API)
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# External News & Real-Time Data APIs (Optional)
# Get a free key from https://newsapi.org
NEWSAPI_KEY=your_newsapi_key_here
NEWS_API_KEY=your_newsapi_key_here

# Get a free key from https://cricapi.com
CRICAPI_KEY=your_cricapi_key_here

# Get a free key from https://www.freenewsapi.io
FREE_NEWS_API_KEY=your_freenewsapi_key_here

# Get a free key from https://openweathermap.org
OPENWEATHER_KEY=your_openweather_key_here

